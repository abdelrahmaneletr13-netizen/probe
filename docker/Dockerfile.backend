# Multi-stage: build the backend JS, then assemble the runtime image that
# also contains all pentest tools so a single container serves the API.

# ── Stage 1: build the Node backend ──────────────────────────────────────────
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY backend/package.json backend/tsconfig.json ./
RUN npm install --no-audit --no-fund
COPY backend/src ./src
RUN npm run build

# ── Stage 2: runtime with pentest tools ──────────────────────────────────────
FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000 \
    LOG_PRETTY=false \
    GOBIN=/usr/local/bin \
    GOPATH=/tmp/go

# System tools available in Debian bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      dnsutils \
      nmap \
      whatweb \
      perl \
      libnet-ssleay-perl \
      openssl \
      golang-go \
      nodejs \
      npm \
 && rm -rf /var/lib/apt/lists/*

# nikto — not in Debian bookworm repos; install from upstream source
RUN git clone --depth=1 https://github.com/sullo/nikto /opt/nikto \
 && chmod +x /opt/nikto/program/nikto.pl \
 && ln -sf /opt/nikto/program/nikto.pl /usr/local/bin/nikto

# httpx — projectdiscovery Go binary
RUN go install github.com/projectdiscovery/httpx/cmd/httpx@latest \
 && rm -rf /tmp/go /root/.cache \
 && apt-get purge -y golang-go git \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Sanity check all tools are on PATH
RUN nmap --version \
 && whatweb --version \
 && nikto -Version \
 && httpx -version

WORKDIR /app
COPY backend/package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY --from=build /app/dist ./dist

EXPOSE 10000
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${PORT:-10000}/healthz || exit 1
CMD ["node", "dist/index.js"]
