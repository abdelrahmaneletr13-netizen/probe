# Multi-stage: build the backend JS, then assemble the runtime image that
# also contains all pentest tools so a single container serves the API.

# ── Stage 1: build the Node backend ──────────────────────────────────────────
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY backend/package.json backend/tsconfig.json ./
RUN npm install --no-audit --no-fund
COPY backend/src ./src
RUN npm run build

# ── Stage 2: runtime with pentest tools ──────────────────────────────────────
FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000 \
    LOG_PRETTY=false \
    HTTPX_VERSION=1.6.10

# System tools available in Debian bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      unzip \
      git \
      dnsutils \
      whois \
      bash \
      nmap \
      whatweb \
      perl \
      libnet-ssleay-perl \
      libjson-perl \
      libxml-writer-perl \
      libio-socket-ssl-perl \
      libwww-perl \
      libnet-ssleay-perl \
      openssl \
      nodejs \
      npm \
 && rm -rf /var/lib/apt/lists/*

# nikto — not in Debian bookworm repos; install from upstream source
RUN git clone --depth=1 https://github.com/sullo/nikto /opt/nikto \
 && chmod +x /opt/nikto/program/nikto.pl \
 && ln -sf /opt/nikto/program/nikto.pl /usr/local/bin/nikto

# httpx — pre-built binary from projectdiscovery (multi-arch)
RUN ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64)  HTTPX_ARCH=amd64 ;; \
      aarch64) HTTPX_ARCH=arm64 ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/httpx.zip \
      "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_${HTTPX_ARCH}.zip" \
 && unzip -q /tmp/httpx.zip -d /tmp/httpx \
 && mv /tmp/httpx/httpx /usr/local/bin/httpx \
 && chmod +x /usr/local/bin/httpx \
 && rm -rf /tmp/httpx /tmp/httpx.zip \
 && apt-get purge -y unzip git \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Sanity check all tools are on PATH
RUN nmap --version \
 && whatweb --version \
 && nikto -Version \
 && httpx -version

WORKDIR /app
COPY backend/package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY --from=build /app/dist ./dist

EXPOSE 10000
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${PORT:-10000}/healthz || exit 1
CMD ["node", "dist/index.js"]
