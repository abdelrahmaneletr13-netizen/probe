# Comma-separated list of API keys allowed to authenticate.
# Generate with: openssl rand -hex 32
PENTEST_IDE_API_KEYS=dev-key-change-me

# Bind host/port for the HTTP server.
HOST=0.0.0.0
PORT=8787

# Hard cap on concurrent runs across the whole instance.
MAX_CONCURRENT_RUNS=4

# Per-run wall-clock timeout in seconds.
RUN_TIMEOUT_SECONDS=300

# If "true", refuses any target that is not a public IP/hostname.
# Set to "false" only for local self-hosting where you scan internal hosts.
REQUIRE_PUBLIC_TARGETS=false

# Comma separated allowlist of targets (CIDRs / hostnames). Empty = allow any
# that passes the public/private check above. Useful for SaaS deployments.
TARGET_ALLOWLIST=

# Pretty-printed logs in dev. Set to "false" in prod for JSON logs.
LOG_PRETTY=true
